# SPDX-License-Identifier: GPL-2.0-only
# Merge after the common piano and desktop fragments. Root dependencies are
# built in; the remaining desktop drivers keep their standard module policy.
CONFIG_BOOT_CONFIG=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
# The firmware scanout is the root console: simple-framebuffer holds dispcc
# clocks and GDSCs, so dispcc must bind before clk_disable_unused runs.
CONFIG_SM_DISPCC_8750=y
# CONFIG_SCSI_UFS_CRYPTO is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_SCSI_UFS_HWMON is not set
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_LSM=y
# Ubuntu's linux-firmware ships .zst files. The loader still tries the plain
# name in every firmware path first, so local plain files keep precedence.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# systemd on the installed Ubuntu: PSI for systemd-oomd, zram for a
# swap-on-zram generator, CFS bandwidth for CPUQuota=, and fq_codel for
# the net.core.default_qdisc set by systemd's 50-default.conf.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_SCH_FQ_CODEL=m
# BlueZ creates Bluetooth LE HID (HoG) devices through /dev/uhid; hidraw
# gives userspace (FIDO2 keys, controllers) access to HID devices.
CONFIG_UHID=m
CONFIG_HIDRAW=y

# SPDX-License-Identifier: GPL-2.0-only
# Piano supervised read-only fuel-gauge diagnostic; merge after
# piano-diagnostic.config into a separate build output, never the default.
# The RAM candidate has no modules, so the GENI I2C host is built in. The
# gauge driver, GPI DMA and TSENS are already built in by the base fragment
# and are listed so the build fails if that changes. BQ27XXX data-memory
# (NVM) updates stay off; no charger, PMIC GLINK/battmgr or LMh driver is
# added (they remain modules that the RAM candidate does not carry).
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
# CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM is not set
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y

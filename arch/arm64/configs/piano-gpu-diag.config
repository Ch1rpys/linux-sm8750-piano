# SPDX-License-Identifier: GPL-2.0-only
# Piano supervised Adreno 830 diagnostic; merge after piano-diagnostic.config
# into a separate build output, never the default. The RAM candidate has no
# modules, so the GPU clock controller, the MSM DRM driver and the MDT loader
# for the zap shader are built in. LLCC and OCMEM are left out: the RAM
# candidates never loaded the LLCC module, and OCMEM does not exist on SM8750.
# simpledrm keeps scanning out; MDSS stays disabled in the device tree.
CONFIG_DRM_MSM=y
CONFIG_SM_GPUCC_8750=y
CONFIG_QCOM_MDT_LOADER=y
# CONFIG_QCOM_LLCC is not set
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_SIMPLEDRM=y

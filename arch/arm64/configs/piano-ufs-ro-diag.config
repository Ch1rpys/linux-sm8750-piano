# SPDX-License-Identifier: GPL-2.0-only
# Piano supervised read-only UFS identification; merge after
# piano-diagnostic.config into a separate build output, never the default.
# The RAM candidate has no modules, so the host, its Qualcomm hooks and the
# QMP UFS PHY are built in. Inline crypto (ICE/SCM key paths), the UFS BSG
# node and the UFS hwmon device stay out of the first run.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
# CONFIG_SCSI_UFS_CRYPTO is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_SCSI_UFS_HWMON is not set

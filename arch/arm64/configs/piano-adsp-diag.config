# Supervised ADSP firmware/PAS/GLINK/QRTR diagnostic, not audio or charging.
# Base DTB remains disabled. No CDSP, gauge buses or GPU are enabled.
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y
# Keep consumers outside this experiment; the MCA protocol is not battmgr.
# CONFIG_QCOM_PMIC_GLINK is not set
# CONFIG_QCOM_FASTRPC is not set
# CONFIG_QCOM_APR is not set

# SPDX-License-Identifier: GPL-2.0-only
# Piano supervised keyboard-bridge diagnostic; merge after
# piano-diagnostic.config into a separate build output, never the default.
# The RAM candidate has no modules, so the GENI I2C host, the Nanosic
# transport and hid-multitouch (touchpad collection) are built in. GPI DMA,
# the HID core, hid-generic and evdev are already built in by the base
# fragment and are listed so the build fails if that changes. The stock MCU
# application is supplied privately through the initramfs firmware tree.
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_NANOSIC=y
CONFIG_INPUT_EVDEV=y

# SPDX-License-Identifier: GPL-2.0-only
# Piano supervised Bluetooth diagnostic; merge after piano-diagnostic.config
# into a separate build output, never the default. The RAM candidate has no
# modules, so the Bluetooth core, the QCA UART protocol over serdev, rfkill and
# the WCN power sequencer are built in. BT_LE is needed for LE scanning (off in
# the arm64 defconfig). WLAN, PCIe power control and ath12k stay out.
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y

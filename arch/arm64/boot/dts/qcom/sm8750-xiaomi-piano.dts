/dts-v1/;

#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm8750.dtsi"
#include "pmih0108.dtsi"
#include "pmk8550.dtsi"
#include "sm8750-pmics.dtsi"

/delete-node/ &cpusys_vm_mem;
/delete-node/ &adspslpi_mem;
/delete-node/ &oem_vm_mem;

#define PIANO_MODEL		"Xiaomi Pad 8 Pro"
#define PIANO_COMPATIBLE	"xiaomi,piano", "qcom,sm8750"

/ {
	model = PIANO_MODEL;
	compatible = PIANO_COMPATIBLE;
	chassis-type = "tablet";

	/*
	 * ABL replaces model/compatible with the stock DTBO's ("qcom,sun-mtp",
	 * ...), which breaks root match tables. CONFIG_QCOM_ABL_ROOT_IDENTITY
	 * restores them from these copies; the DTBO does not carry them
	 * (TD-001).
	 */
	xiaomi,mainline-model = PIANO_MODEL;
	xiaomi,mainline-compatible = PIANO_COMPATIBLE;

	aliases {
		serial0 = &uart7;
	};

	chosen {
		stdout-path = "serial0:115200n8";

		/* Firmware scanout; replace with native DPU/panel ownership. */
		framebuffer {
			compatible = "simple-framebuffer";
			memory-region = <&splash_mem>;
			/*
			 * Scanout is owned by the bootloader until native MDSS
			 * takes over. Hold the display power domains and the
			 * clocks it left running, so dispcc and rpmhpd
			 * sync_state do not power them off underneath the
			 * framebuffer. MMCX is first so required-opps applies
			 * to it; nom_l1 matches the 575 MHz MDP clock rate.
			 */
			clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
				 <&dispcc DISP_CC_MDSS_AHB_CLK>,
				 <&dispcc DISP_CC_MDSS_MDP_CLK>,
				 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE0_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>,
				 <&dispcc DISP_CC_MDSS_PCLK0_CLK>,
				 <&dispcc DISP_CC_MDSS_ESC0_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE1_CLK>,
				 <&dispcc DISP_CC_MDSS_BYTE1_INTF_CLK>,
				 <&dispcc DISP_CC_MDSS_PCLK1_CLK>,
				 <&dispcc DISP_CC_MDSS_ESC1_CLK>;
			power-domains = <&rpmhpd RPMHPD_MMCX>,
					<&dispcc MDSS_GDSC>,
					<&dispcc MDSS_INT2_GDSC>;
			required-opps = <&rpmhpd_opp_nom_l1>;
			/*
			 * The scanout fetches from DDR on the same path as the
			 * native MDSS "mdp0-mem". Once interconnect sync_state
			 * drops the boot-time floor, nothing else keeps that
			 * path up, so the framebuffer votes its own bandwidth.
			 */
			interconnects = <&mmss_noc MASTER_MDP QCOM_ICC_TAG_ALWAYS
					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
			interconnect-names = "mdp0-mem";
			operating-points-v2 = <&framebuffer_opp_table>;
			width = <3200>;
			height = <2136>;
			stride = <(3200 * 4)>;
			format = "x8r8g8b8";

			/*
			 * Firmware scanout mode: 3200x2136 x8r8g8b8 (4 bytes
			 * per pixel) at 120 Hz, measured from the INTF1/INTF2
			 * frame counters (+60 per 0.5 s); vertical total 2310
			 * lines (2136 active, front porch 68, back porch 104,
			 * sync 2) from the stock 120 Hz panel timing.
			 *
			 * opp-avg-kBps: the frame read once per refresh,
			 *   3200 * 2136 * 4 B * 120 Hz = 3280896 kB/s.
			 * opp-peak-kBps: each active line is read within one
			 *   line time of the 2310-line frame, plus the DPU bus
			 *   inefficiency margin of 120/100 for SM8750, as in
			 *   _dpu_plane_calc_bw() and _dpu_core_perf_calc_bw():
			 *   3200 * 2310 * 4 B * 120 Hz * 1.2 = 4257792 kB/s.
			 */
			framebuffer_opp_table: opp-table {
				compatible = "operating-points-v2";

				opp-0 {
					opp-peak-kBps = <4257792>;
					opp-avg-kBps = <3280896>;
				};
			};
		};
	};

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;
			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	reserved-memory {
		display_dump_mem: display-dump@81cf4000 {
			reg = <0x0 0x81cf4000 0x0 0x800>;
			no-map;
		};

		reserved@9b09c000 {
			reg = <0x0 0x9b09c000 0x0 0x4000>;
			no-map;
		};

		reserved@9eb80000 {
			reg = <0x0 0x9eb80000 0x0 0x80000>;
			no-map;
		};

		ramoops@a3500000 {
			compatible = "ramoops";
			reg = <0x0 0xa3500000 0x0 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		adspslpi_mem: adspslpi@b8200000 {
			reg = <0x0 0xb8200000 0x0 0x5780000>;
			no-map;
		};

		oem_vm_mem: oem-vm@f8800000 {
			reg = <0x0 0xf8800000 0x0 0x3800000>;
			no-map;
		};

		vm_shared_mem: vm-shared@fc000000 {
			reg = <0x0 0xfc000000 0x0 0x400000>;
			no-map;
		};

		/* ABL powers down the display unless this name is splash_region. */
		splash_mem: splash_region@fc800000 {
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			no-map;
		};
	};

	/*
	 * WCN7860 (GANGES) package PMU. Inputs, enables and clock follow the
	 * stock bt_peach/cnss nodes. The chip AON input is on S5F and the
	 * WLMX (digital) input on S4D (stock qcom,pmu_vreg_map, stock BT
	 * aon/dig supplies). The outputs are the PMU domains named in the
	 * same map; consumers only reference them to find this sequencer.
	 * Enabled only by the supervised bt-diag variant.
	 */
	wcn7860_pmu: wcn7860-pmu {
		compatible = "qcom,wcn7860-pmu";

		pinctrl-0 = <&wlan_en>, <&bt_en_default>;
		pinctrl-names = "default";

		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
		swctrl-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;

		vddio-supply = <&vreg_l3f_1p8>;
		vddio1p2-supply = <&vreg_l2f_1p2>;
		vddaon-supply = <&vreg_s5f_0p88>;
		vdddig-supply = <&vreg_s4d_0p88>;
		vddrfa1p2-supply = <&vreg_s7i_1p31>;
		vddrfa1p8-supply = <&vreg_s3g_1p86>;

		clocks = <&rpmhcc RPMH_RF_CLK1>;

		status = "disabled";

		regulators {
			vreg_pmu_aon_0p9: ldo0 {
				regulator-name = "vreg_pmu_aon_0p9";
			};

			vreg_pmu_rfa_1p9: ldo1 {
				regulator-name = "vreg_pmu_rfa_1p9";
			};

			vreg_pmu_rfa_1p3: ldo2 {
				regulator-name = "vreg_pmu_rfa_1p3";
			};

			vreg_pmu_rfa_0p9: ldo3 {
				regulator-name = "vreg_pmu_rfa_0p9";
			};

			vreg_pmu_wlmx_0p9: ldo4 {
				regulator-name = "vreg_pmu_wlmx_0p9";
			};

			vreg_pmu_wlcx_0p9: ldo5 {
				regulator-name = "vreg_pmu_wlcx_0p9";
			};

			vreg_pmu_btcx_0p9: ldo6 {
				regulator-name = "vreg_pmu_btcx_0p9";
			};

			vreg_pmu_btcmx_0p9: ldo7 {
				regulator-name = "vreg_pmu_btcmx_0p9";
			};

			vreg_pmu_pcie_1p2: ldo8 {
				regulator-name = "vreg_pmu_pcie_1p2";
			};

			vreg_pmu_pcie_0p9: ldo9 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};
		};
	};
};

&apps_rsc {
	/*
	 * Only stock-verified output rails (USB, UFS, PCIe0 PHY, WCN7860 PMU
	 * inputs, keyboard bridge); input topology is not yet known. UFS, WCN and
	 * keyboard rails carry no initial mode, so they send no RPMh vote until a
	 * consumer enables them. WCN ranges are the intersection of the stock BT
	 * and WLAN consumer ranges.
	 */
	regulators-0 {
		compatible = "qcom,pm8550-rpmh-regulators";
		qcom,pmic-id = "b";

		vreg_l5b_3p1: ldo5 {
			regulator-name = "vreg_l5b_3p1";
			regulator-min-microvolt = <3100000>;
			regulator-max-microvolt = <3148000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* Stock keyboard bridge dvdd (1800000 uV request, VSET reads 1800 mV). */
		vreg_l11b_1p8: ldo11 {
			regulator-name = "vreg_l11b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};

		/*
		 * Stock keyboard bridge vdd. The stock kernel requests 3300000 uV,
		 * which is off the 8 mV PLDO step; the PMIC LDO14 VSET register on
		 * this unit reads 0x0ce0 (3296 mV) while that request is active.
		 */
		vreg_l14b_3p3: ldo14 {
			regulator-name = "vreg_l14b_3p3";
			regulator-min-microvolt = <3296000>;
			regulator-max-microvolt = <3296000>;
		};

		vreg_l15b_1p8: ldo15 {
			regulator-name = "vreg_l15b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l17b_2p5: ldo17 {
			regulator-name = "vreg_l17b_2p5";
			regulator-min-microvolt = <2504000>;
			regulator-max-microvolt = <2504000>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "d";

		vreg_s4d_0p88: smps4 {
			regulator-name = "vreg_s4d_0p88";
			regulator-min-microvolt = <876000>;
			regulator-max-microvolt = <1036000>;
		};

		vreg_l1d_1p2: ldo1 {
			regulator-name = "vreg_l1d_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2d_0p88: ldo2 {
			regulator-name = "vreg_l2d_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-2 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "g";

		/* Stock 1860000 uV is off the 8 mV step above 1376000 uV. */
		vreg_s3g_1p86: smps3 {
			regulator-name = "vreg_s3g_1p86";
			regulator-min-microvolt = <1864000>;
			regulator-max-microvolt = <2000000>;
		};

		vreg_l3g_1p2: ldo3 {
			regulator-name = "vreg_l3g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1256000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-3 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "j";

		/* The UFS PHY needs at least 912 mV within the 880-920 mV rail range. */
		vreg_l1j_0p91: ldo1 {
			regulator-name = "vreg_l1j_0p91";
			regulator-min-microvolt = <912000>;
			regulator-max-microvolt = <920000>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-4 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "f";

		vreg_s5f_0p88: smps5 {
			regulator-name = "vreg_s5f_0p88";
			regulator-min-microvolt = <876000>;
			regulator-max-microvolt = <1000000>;
		};

		/*
		 * REFGEN_VDD_A_0P9 / VDD_A_PCIE_0_0P9 on the SM8750 power grid
		 * (stock ufsphy_mem vdda-refgen-supply, 206 mA, and the eUSB2 PHY
		 * vdd_refgen-supply). The UFS and eUSB2 PHY bindings have no
		 * refgen supply, so the PCIe0 PHY would be its only switchable
		 * consumer and could turn the UFS/USB reference off on a PCIe
		 * probe deferral or link failure. Keep it on, as the stock
		 * active-set vote (L1F_AO) does.
		 */
		vreg_l1f_0p88: ldo1 {
			regulator-name = "vreg_l1f_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		vreg_l2f_1p2: ldo2 {
			regulator-name = "vreg_l2f_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};

		vreg_l3f_1p8: ldo3 {
			regulator-name = "vreg_l3f_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "i";

		vreg_s7i_1p31: smps7 {
			regulator-name = "vreg_s7i_1p31";
			regulator-min-microvolt = <1312000>;
			regulator-max-microvolt = <1340000>;
		};
	};
};

/*
 * Device-signed zap shader, taken from this unit's ODM image and supplied
 * only through a private RAM-candidate firmware directory. The GPU itself
 * stays disabled here; only the supervised gpu-diag variant enables it.
 */
&gpu_zap_shader {
	firmware-name = "qcom/sm8750/xiaomi/piano/gen80000_zap.mbn";
};

&gunyah_hyp_mem {
	reg = <0x0 0x80000000 0x0 0x1200000>;
};

/* Stock sets the TLMM I2C pull-up (qcom,i2c_pull) on the backlight buses. */
&hub_i2c3_data_clk {
	bias-pull-up = <2200>;
};

/*
 * Keep both buses disabled outside the supervised power-diag variant. SE5 is
 * marked multi-EE (qcom,shared) in the stock tree; this kernel has no GPI
 * lock/unlock support for sharing it with another execution environment.
 */
&i2c5 {
	fuel-gauge@55 {
		compatible = "ti,bq27z561";
		reg = <0x55>;
	};
};

&i2c6 {
	/* Stock qcom,clk-freq-out on the keyboard bridge bus. */
	clock-frequency = <1000000>;

	/*
	 * Nanosic WN8030 keyboard bridge. Stock requests both interrupts with
	 * IRQF_TRIGGER_RISING | IRQF_ONESHOT. Kept disabled outside the
	 * supervised kbd-diag variant: the driver holds the bridge awake while
	 * bound and has no runtime/system PM yet.
	 */
	keyboard@4c {
		compatible = "xiaomi,piano-keyboard";
		reg = <0x4c>;

		interrupt-parent = <&tlmm>;
		interrupts = <97 IRQ_TYPE_EDGE_RISING>,
			     <95 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq",
				  "wakeup";

		reset-gpios = <&tlmm 188 GPIO_ACTIVE_LOW>;
		wake-gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;

		vdd-supply = <&vreg_l14b_3p3>;
		dvdd-supply = <&vreg_l11b_1p8>;

		firmware-name = "nanosic/piano/MCU_Upgrade.bin";

		pinctrl-0 = <&keyboard_default>;
		pinctrl-names = "default";

		status = "disabled";
	};
};

&i2c8 {
	/* Stock has no qcom,clk-freq-out, so the vendor GENI driver uses 400 kHz. */
	clock-frequency = <400000>;

	/* Stock ktz8866,id = <1>; programmed together with the chip on I2C hub 3. */
	backlight_secondary: backlight@11 {
		compatible = "kinetic,ktz8866";
		reg = <0x11>;
		kinetic,secondary;
	};
};

&i2c11 {
	fuel-gauge@55 {
		compatible = "ti,bq27z561";
		reg = <0x55>;
	};
};

/*
 * The two KTZ8866 each drive half of the LED strings of the one LCD panel.
 * The firmware turns them on and sets up the panel bias; the bias outputs
 * are the panel's supplies (stock display_panel_vsp/vsn on GPIO117/118) and
 * are not described here. Both buses stay disabled in the board DTB.
 */
&i2c_hub_3 {
	/* Stock has no qcom,clk-freq-out, so the vendor GENI driver uses 400 kHz. */
	clock-frequency = <400000>;

	/* Stock ktz8866,id = <0>, the only one with ktz8866,hwen-gpio. */
	backlight: backlight@11 {
		compatible = "kinetic,ktz8866";
		reg = <0x11>;
		enable-gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
		/* The stock driver always writes BL_EN 0x7f/0x3f: six sinks. */
		current-num-sinks = <6>;
		kinetic,secondary-backlight = <&backlight_secondary>;
	};
};

&mdss_dp0_out {
	/* Stock limits the DP link clock to 540000 kHz (HBR2). */
	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000>;
};

&mpss_mem {
	status = "disabled";
};

/*
 * WCN7860 WLAN on PCIe0, as in the stock pcie@1c00000/cnss-peach nodes:
 * PERST# TLMM102, CLKREQ# TLMM103, WAKE# TLMM104 (stock pinctrl equals
 * pcie0_default_state). The stock PHY rails are CESTA-managed and not named;
 * L1F is VDD_A_PCIE_0_0P9 per the SM8750 power grid note kept in the stock
 * UFS PHY node, and L3G is the 1.2 V PHY rail that also feeds the UFS, USB
 * and USB/DP PHYs. Enabled only by the supervised wlan-diag variant.
 */
&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1f_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;
};

&pcieport0 {
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	/* Supplies are the WLAN-function outputs of qcom,pmu_vreg_map. */
	wifi@0 {
		compatible = "pci17cb,110e";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddaon-supply = <&vreg_pmu_aon_0p9>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p9>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p9>;
		vddrfa0p9-supply = <&vreg_pmu_rfa_0p9>;
		vddrfa1p3-supply = <&vreg_pmu_rfa_1p3>;
		vddrfa1p9-supply = <&vreg_pmu_rfa_1p9>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p2-supply = <&vreg_pmu_pcie_1p2>;
	};
};

&pm8550ve_f_gpios {
	/* Stock bt_uwb_en: VIN1, no bias, output. */
	bt_en_default: bt-en-default-state {
		pins = "gpio3";
		function = "normal";
		power-source = <1>;
		bias-disable;
		output-low;
	};
};

&pmih0108_eusb2_repeater {
	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;

	qcom,tune-usb2-amplitude = /bits/ 8 <0xe>;
	qcom,tune-res-fsdif = /bits/ 8 <0x1>;
	qcom,tune-usb2-disc-thres = /bits/ 8 <0x7>;
	qcom,tune-usb2-preem = /bits/ 8 <0x6>;
	qcom,squelch-detector-bp = <(-3000)>;
};

&pon_pwrkey {
	status = "okay";
};

/* Stock sets the TLMM I2C pull-up (qcom,i2c_pull) on both fuel-gauge buses. */
&qup_i2c5_data_clk {
	bias-pull-up = <2200>;
};

&qup_i2c11_data_clk {
	bias-pull-up = <2200>;
};

/* Stock leaves the internal pull-up off on the keyboard bridge bus. */
&qup_i2c6_data_clk {
	/delete-property/ bias-pull-up;
	bias-disable;
};

&qup_i2c8_data_clk {
	bias-pull-up = <2200>;
};

&qupv3_1 {
	status = "okay";
};

/* Enable only for a supervised THP test with panel power already present. */
&spi2 {
	status = "disabled";

	touchscreen@0 {
		compatible = "novatek,nt36532e";
		reg = <0>;
		spi-max-frequency = <19200000>;
		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_EDGE_RISING>;
		firmware-name = "novatek/piano/novatek_nt36532_piano_fw_csot.bin";
		status = "disabled";
	};
};

&tlmm {
	gpio-reserved-ranges = <36 4>, <48 4>, <74 1>;

	/* Stock xiaomi_keyboard_{sleep_,}default: wake, reset and status pins. */
	keyboard_default: keyboard-default-state {
		wake-pins {
			pins = "gpio3";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
		};

		reset-status-pins {
			pins = "gpio95", "gpio188";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	/* Stock cnss_wlan_en_sleep: WLAN held off unless its sequencer target is on. */
	wlan_en: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};
};

/*
 * The trace NOC has no consumer on this board (no CoreSight trace is used),
 * and it never binds: the AMBA bus maps an unreadable PrimeCell/CoreSight ID
 * to -EPROBE_DEFER, so piano lists "amba 109ab000.tn: deferred probe pending"
 * at the deferred probe timeout (BigfootACA reports that the ID reads as 0 on
 * this part). From BigfootACA/linux da72dd806bf0 (Junhao Xie, BSD-3-Clause);
 * referenced by path because sm8750.dtsi has no label for the node.
 */
&{/soc@0/tn@109ab000} {
	status = "disabled";
};

&trust_ui_vm_mem {
	reg = <0x0 0xf3800000 0x0 0x5000000>;
};

/* Stock ttyHS0 (qupv3 SE14): TX/RX plus CTS/RTS for hardware flow control. */
&uart14 {
	pinctrl-0 = <&qup_uart14_default>, <&qup_uart14_cts_rts>;
	pinctrl-names = "default";

	status = "disabled";

	bluetooth {
		compatible = "qcom,wcn7860-bt";

		vddaon-supply = <&vreg_pmu_aon_0p9>;
		vddbtcx-supply = <&vreg_pmu_btcx_0p9>;
		vddbtcmx-supply = <&vreg_pmu_btcmx_0p9>;
		vddrfa0p9-supply = <&vreg_pmu_rfa_0p9>;
		vddrfa1p3-supply = <&vreg_pmu_rfa_1p3>;
		vddrfa1p9-supply = <&vreg_pmu_rfa_1p9>;

		/* Baud index 0x11 (3.2 Mbaud) in every stock gngbtnv20 NVM. */
		max-speed = <3200000>;
	};
};

&uart7 {
	status = "okay";
};

/*
 * Only for a supervised read-only identification variant. The PHY QREF and
 * REFGEN rails, the reset pad (PX14) rail and the VCCQ parent have no
 * upstream consumer and stay as the boot firmware left them.
 */
&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;
	vccq-max-microamp = <1200000>;

	status = "disabled";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "disabled";
};

&usb {
	/* Bounded USB2 diagnostics until the Type-C/ADSP path is supported. */
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
	qcom,select-utmi-as-pipe-clk;
	/delete-property/ usb-role-switch;

	status = "okay";
};

/* Stock combo PHY uses L2D for vdd and L3G for its 1.2 V core supply.
 * Keep it disabled until Type-C routing and a supervised test are ready.
 */
&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l2d_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;
};

&usb_hsphy {
	vdd-supply = <&vreg_l2d_0p88>;
	vdda12-supply = <&vreg_l3g_1p2>;
	phys = <&pmih0108_eusb2_repeater>;

	status = "okay";
};

&xbl_ramdump_mem {
	reg = <0x0 0xb8000000 0x0 0x200000>;
};
